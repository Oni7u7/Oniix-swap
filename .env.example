# Trading API key de Uniswap. SECRETO — solo se usa en Route Handlers del backend
# (app/api/*). Nunca le pongas el prefijo NEXT_PUBLIC_ ni la referencies desde el cliente.
# Se obtiene en https://developers.uniswap.org/
UNISWAP_API_KEY=

# RPC privada por red. Son NEXT_PUBLIC_ (viajan al cliente) a propósito: wagmi/RainbowKit
# las necesitan en el browser para leer balances, hacer switchChain, etc. Para que sigan
# siendo seguras, restringe cada una por dominio (HTTP referrer allowlist) en el panel de
# tu proveedor (Alchemy/Infura) a tu dominio de producción — así nadie más puede usarlas
# aunque las vea en el bundle del cliente. Si las dejas vacías en desarrollo, la app cae
# automáticamente al RPC público de viem/chains (más lento, sin allowlist, pero funcional).
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_OPTIMISM=
NEXT_PUBLIC_RPC_URL_POLYGON=
NEXT_PUBLIC_RPC_URL_ARBITRUM=

# WalletConnect Cloud project id. Público, se usa para el modal de conexión de RainbowKit.
# Se obtiene en https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Alchemy Prices API key. SECRETO — solo se usa en /app/api/price-history y
# /app/api/price-current (Route Handlers). Puede ser una app de Alchemy distinta a la
# de las RPC_URL_* de arriba — revisa su propio allowlist en el dashboard.
ALCHEMY_API_KEY=

# Origin que está en el allowlist de la API key de arriba. La Prices API de Alchemy
# EXIGE un Origin permitido incluso en llamadas servidor-a-servidor sin navegador; sin
# esto responde "Unspecified origin not on whitelist." Configúralo en el dashboard de
# Alchemy (Security -> Allowlist) para la app de Prices, y pon aquí ese mismo valor
# (ej. "http://localhost:3000" en dev, tu dominio real en producción).
ALCHEMY_ALLOWED_ORIGIN=
